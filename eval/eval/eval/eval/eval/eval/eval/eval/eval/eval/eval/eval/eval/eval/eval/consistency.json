{
  "consistency_version": "1.0",
  "description": "Consistency specification for YT6 evaluation system: cross-case, cross-turn, and cross-mode consistency rules.",

  "dimensions": {
    "canonical_to_variants": {
      "description": "Check that meaning remains identical across all variants of a testcase.",
      "required": true,
      "rules": {
        "no_synonym_shift": true,
        "no_reinterpretation": true,
        "semantic_equivalence_required": true
      }
    },

    "variants_to_edge_cases": {
      "description": "Check that meaning remains stable even under edge-case phrasing.",
      "required": true,
      "rules": {
        "no_drift": true,
        "no_loss_of_core_semantics": true,
        "no_adversarial_collapse": true
      }
    },

    "multi_turn": {
      "description": "Check that meaning remains stable across multi-turn interactions.",
      "required": true,
      "rules": {
        "no_turnwise_drift": true,
        "no_context_reinterpretation": true,
        "stable_semantic_anchor": true
      }
    },

    "pressure_mode": {
      "description": "Check that meaning remains stable under compression, urgency, or forced brevity.",
      "required": true,
      "rules": {
        "no_semantic_loss": true,
        "no_overcompression": true,
        "no_core-meaning-collapse": true
      }
    },

    "adversarial_mode": {
      "description": "Check that meaning remains stable under adversarial or misleading phrasing.",
      "required": true,
      "rules": {
        "no_trick_reinterpretation": true,
        "no_semantic_flip": true,
        "no_contradiction_acceptance": true
      }
    },

    "reproducibility": {
      "description": "Check that repeated runs produce identical outputs when variance=0.",
      "required": true,
      "rules": {
        "identical_repeat_required": true,
        "variance_zero_required": true,
        "hash_match_required": true
      }
    }
  },

  "scoring": {
    "scale": "0-10",
    "weights": {
      "canonical_to_variants": 0.25,
      "variants_to_edge_cases": 0.20,
      "multi_turn": 0.20,
      "pressure_mode": 0.15,
      "adversarial_mode": 0.10,
      "reproducibility": 0.10
    },
    "pass_threshold": 8,
    "fail_threshold": 5
  },

  "paths": {
    "testcases": "testcases.json",
    "expected": "expected/",
    "results": "results/",
    "traces": "results/traces/",
    "grader": "grader.json",
    "engine": "engine.json",
    "schema": "schema.json"
  }
}
